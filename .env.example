# Copy to .env for local dev / set as GitHub Actions secrets for workers. Never commit real values.
DATABASE_URL=sqlite:///card_offers.db          # Supabase: postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres
DEMO_MODE=true
ALLOWED_EMAIL=you@gmail.com
ALERT_EMAIL=you@gmail.com
APP_URL=https://your-app.streamlit.app
LLM_PROVIDER=openai                             # openai | nvidia
LLM_MODEL=gpt-4.1-mini                          # see README for current examples
OPENAI_API_KEY=
NVIDIA_API_KEY=
GMAIL_TOKEN_JSON=                               # output of: python -m workers.gmail_setup
GMAIL_TOKENS_JSON=                              # optional JSON list of extra account tokens
GITHUB_TOKEN=                                   # fine-grained PAT, Actions: read & write on this repo
GITHUB_REPO=SaiSatyaJagannadh/Credit_Card_Offers
