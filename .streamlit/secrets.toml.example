# Copy to .streamlit/secrets.toml (gitignored) or paste into Streamlit Cloud > App settings > Secrets.
DATABASE_URL = "postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
DEMO_MODE = "false"
ALLOWED_EMAIL = "you@gmail.com"
APP_URL = "https://your-app.streamlit.app"
LLM_PROVIDER = "openai"
LLM_MODEL = "gpt-4.1-mini"
OPENAI_API_KEY = ""
NVIDIA_API_KEY = ""
GITHUB_TOKEN = ""
GITHUB_REPO = "SaiSatyaJagannadh/Credit_Card_Offers"

# st.login (Google OIDC)
[auth]
redirect_uri = "https://your-app.streamlit.app/oauth2callback"
cookie_secret = "<long random string>"
client_id = "<google oauth web client id>"
client_secret = "<google oauth web client secret>"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
